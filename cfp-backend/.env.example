# .env.example — copy to .env and fill in your values
# Never commit .env to version control.
# On Render, you won't use this file directly — enter these same
# key/value pairs one at a time under the service's Environment tab.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=change-me-before-deploying

# ── Email (optional — token is logged to console if not configured) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@cfpcommons.org

# ── Site ──────────────────────────────────────────────────────────────────────
# On Render, set this to your actual https://your-service.onrender.com URL
SITE_URL=https://cfpcommons.org

# ── Moderation ────────────────────────────────────────────────────────────────
REQUIRE_APPROVAL=true
REQUIRE_EXTENSION_APPROVAL=true
MAX_EXTENSION_MONTHS=6

# ── Free-tier hosting support ─────────────────────────────────────────────────
# Render's free instance type has no persistent disk, so the whole SQLite
# file resets on every redeploy and every cold-start wake-up. With this set
# to true, the app re-populates itself with sample CFPs automatically on
# every fresh startup, so the demo never looks empty/broken.
#
# Flip to false once you're on paid hosting with real persistence, or once
# real users start submitting for real.
AUTO_SEED_DEMO_DATA=true
